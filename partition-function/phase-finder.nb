Cell[TextData[{
 "Generate  equations for a conjugacy class g. It\[CloseCurlyQuote]s much \
faster to apply RootReduce only to the coefficients of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["A", "O"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "3eb1e256-c6e3-4818-b49a-6672e72c0ef5"],
 "and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["B", "O"], "'"}], 
    RowBox[{"s", "."}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2c7f641e-afa5-46f1-bae1-f648a5c23174"]
}], "Text",ExpressionUUID->"187a7776-5427-4a20-bfa5-d13b1097d06e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"genEqsAB", "[", 
   RowBox[{"g_", ",", "func_"}], "]"}], ":=", 
  RowBox[{"Catch", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"message", "=", 
     RowBox[{"\"\<generating eqs with \>\"", "<>", 
      RowBox[{"ToString", "[", "func", "]"}], "<>", "\"\<...\>\""}]}], ";", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"tmp", "=", 
        RowBox[{"{", "}"}]}], "}"}], ",", 
      RowBox[{
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Module", "[", 
           RowBox[{
            RowBox[{"{", "Ng\[Chi]", "}"}], ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"Ng\[Chi]", "=", 
              RowBox[{"Collect", "[", 
               RowBox[{
                RowBox[{"func", "[", 
                 RowBox[{"g", ",", "\[Chi]"}], "]"}], ",", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"A", "[", "_", "]"}], ",", 
                  RowBox[{"B", "[", "_", "]"}], ",", 
                  RowBox[{"BB", "[", "_", "]"}]}], "}"}], ",", "RootReduce"}],
                "]"}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"(*", " ", 
              RowBox[{
               RowBox[{
                RowBox[{
                "If", " ", "we", " ", "detect", " ", "a", " ", "B", " ", "in",
                  " ", "this", " ", "g"}], "-", "sector"}], ",", " ", 
               RowBox[{
               "we", " ", "move", " ", "on", " ", "to", " ", "the", " ", 
                "next", " ", "one"}]}], " ", "*)"}], "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"!", 
                 RowBox[{"FreeQ", "[", 
                  RowBox[{"Ng\[Chi]", ",", "_A"}], "]"}]}], "||", 
                RowBox[{"!", 
                 RowBox[{"FreeQ", "[", 
                  RowBox[{"Ng\[Chi]", ",", "_B"}], "]"}]}]}], ",", 
               RowBox[{"PrependTo", "[", 
                RowBox[{"tmp", ",", "Ng\[Chi]"}], "]"}]}], "]"}]}]}], "]"}], 
          ";", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Length", "[", "tmp", "]"}], ">=", "10"}], ",", 
            RowBox[{
             RowBox[{"eqsA", "=", 
              RowBox[{"Join", "[", 
               RowBox[{"tmp", ",", "eqsA"}], "]"}]}], ";", 
             RowBox[{"tmp", "=", 
              RowBox[{"{", "}"}]}]}]}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"\[Chi]", ",", 
           RowBox[{"Length", "[", 
            RowBox[{"sizes", "[", 
             RowBox[{"[", "g", "]"}], "]"}], "]"}]}], "}"}]}], "]"}], ";", 
       RowBox[{"eqsA", "=", 
        RowBox[{"Join", "[", 
         RowBox[{"tmp", ",", "eqsA"}], "]"}]}]}]}], "]"}]}], "]"}]}]], "Input",\

 CellLabel->"In[81]:=",ExpressionUUID->"d265b4e9-a3ab-43f2-8598-840717816b2f"],

