 ":"
}], "Text",ExpressionUUID->"2a176b49-096c-4e6b-937c-77fd3354fdc8"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Bcases", "[", "orb_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "aorder", "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"aorder", "=", 
       RowBox[{
        RowBox[{"Extract", "[", 
         RowBox[{"abelianOrders", ",", 
          RowBox[{"betterOrbitRep", "[", 
           RowBox[{"[", "orb", "]"}], "]"}]}], "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"B", "[", "orb", "]"}], "->", 
           RowBox[{"Exp", "[", 
            RowBox[{"2", "\[Pi]", " ", "I", " ", 
             FractionBox["n", 
              RowBox[{"LCM", "[", 
               RowBox[{"2", ",", "aorder"}], "]"}]]}], "]"}]}], ",", 
          RowBox[{
           RowBox[{"BB", "[", "orb", "]"}], "->", 
           RowBox[{"Exp", "[", 
            RowBox[{
             RowBox[{"-", "2"}], "\[Pi]", " ", "I", " ", 
             FractionBox["n", 
              RowBox[{"LCM", "[", 
               RowBox[{"2", ",", "aorder"}], "]"}]]}], "]"}]}]}], "}"}], ",", 
        
        RowBox[{"{", 
         RowBox[{"n", ",", "0", ",", 
          RowBox[{
           RowBox[{"LCM", "[", 
            RowBox[{"2", ",", "aorder"}], "]"}], "-", "1"}]}], "}"}]}], 
       "]"}]}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[80]:=",ExpressionUUID->"9995b6d9-8490-43b2-b3c9-6e5c33f73a7b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MaxVar", "=", "10"}], ";"}]], "Input",
 CellLabel->"In[54]:=",ExpressionUUID->"60952b2a-c2cc-4ccd-b5e0-31caaea34c59"],

Cell["Here  is  the  main  algorithm :", "Text",ExpressionUUID->"c001b6da-53a8-4d25-964e-c70b5fbc10cc"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"TryFixAB", "[", "]"}], ":=", 
   RowBox[{"While", "[", 
    RowBox[{"True", ",", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "pos", ",", "checks", ",", "integers", ",", "vars", ",", "Aoptions", 
         ",", "result", ",", "Borbits", ",", "CombOptions", ",", "nowEq"}], 
        "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"message", "=", "\"\<examining equations...\>\""}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{
         "Exit", " ", "loop", " ", "if", " ", "all", " ", "equations", " ", 
          "are", " ", "empty"}], " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"eqsA", "==", 
           RowBox[{"{", "}"}]}], ",", 
          RowBox[{
           RowBox[{"message", "=", "\"\<Done!!\>\""}], ";", 
           RowBox[{"Break", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"vars", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"eqsA", "[", 
              RowBox[{"[", "i", "]"}], "]"}], "//", "Expand"}], "//", 
            "Variables"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", 
             RowBox[{"Length", "[", "eqsA", "]"}]}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{
         "Pick", " ", "the", " ", "first", " ", "equation", " ", "with", " ", 
          "the", " ", "fewest", " ", "variables"}], " ", "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"pos", "=", 
         RowBox[{
          RowBox[{"PositionSmallest", "[", 
           RowBox[{
            RowBox[{"Length", "/@", "vars"}], "/.", " ", 
            RowBox[{"0", "->", "Infinity"}]}], "]"}], "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{
         "Exit", " ", "loop", " ", "if", " ", "all", " ", "equations", " ", 
          "are", " ", "empty"}], " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"vars", "[", 
            RowBox[{"[", "pos", "]"}], "]"}], "==", 
           RowBox[{"{", "}"}]}], ",", 
          RowBox[{
           RowBox[{"message", "=", 
            RowBox[{"\"\<Done!!\>\"", 
             RowBox[{"Break", "[", "]"}]}]}], ";"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{
         "Exit", " ", "loop", " ", "if", " ", "all", " ", "equations", " ", 
          "have", " ", "too", " ", "many", " ", "equations"}], " ", "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", 
            RowBox[{"vars", "[", 
             RowBox[{"[", "pos", "]"}], "]"}], "]"}], ">", "MaxVar"}], ",", 
          RowBox[{
           RowBox[{"message", "=", "\"\<Done!!\>\""}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"bckpeqs", "=", 
            RowBox[{"Join", "[", 
             RowBox[{"bckpeqs", ",", "eqsA"}], "]"}]}], ";", 
           RowBox[{"eqsA", "=", 
            RowBox[{"{", "}"}]}], ";", 
           RowBox[{"Break", "[", "]"}], ";"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{
         "Simplify", " ", "the", " ", "equation", " ", "to", " ", "work", " ",
           "on"}], " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"nowEq", "=", 
         RowBox[{
          RowBox[{"eqsA", "[", 
           RowBox[{"[", "pos", "]"}], "]"}], "=", 
          RowBox[{"Collect", "[", 
           RowBox[{
            RowBox[{"eqsA", "[", 
             RowBox[{"[", "pos", "]"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"A", "[", "_", "]"}], ",", 
              RowBox[{"B", "[", "_", "]"}], ",", 
              RowBox[{"BB", "[", "_", "]"}]}], "}"}], ",", "RootReduce"}], 
           "]"}]}]}], ";", 
        RowBox[{"nowEqToDisplay", "=", 
         RowBox[{"nowEq", "/.", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"A", "->", "\"\<A\>\""}], ",", 
            RowBox[{"B", "->", "\"\<B\>\""}], ",", 
            RowBox[{"BB", "->", "\"\<BB\>\""}]}], "}"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{"List", " ", "the", " ", "possibilities", " ", "of", " ", 
          RowBox[{"A", "'"}], "s"}], " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"Aoptions", "=", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Cases", "[", 
             RowBox[{
              RowBox[{"vars", "[", 
               RowBox[{"[", "pos", "]"}], "]"}], ",", "_A"}], "]"}], "!=", 
            RowBox[{"{", "}"}]}], ",", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{
             RowBox[{"Thread", "[", 
              RowBox[{
               RowBox[{"Cases", "[", 
                RowBox[{
                 RowBox[{"vars", "[", 
                  RowBox[{"[", "pos", "]"}], "]"}], ",", "_A"}], "]"}], "->", 
               "#"}], "]"}], "&"}], "/@", 
            RowBox[{"Tuples", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"1", ",", 
                RowBox[{"-", "1"}]}], "}"}], ",", 
              RowBox[{"Length", "@", 
               RowBox[{"Cases", "[", 
                RowBox[{
                 RowBox[{"vars", "[", 
                  RowBox[{"[", "pos", "]"}], "]"}], ",", "_A"}], "]"}]}]}], 
             "]"}]}], ",", "\[IndentingNewLine]", "Nothing"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{"List", " ", "the", " ", "possibilities", " ", "of", " ", 
          RowBox[{"B", "'"}], "s"}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{"Borbits", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"Cases", "[", 
            RowBox[{
             RowBox[{"vars", "[", 
              RowBox[{"[", "pos", "]"}], "]"}], ",", "_B"}], "]"}], "/.", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"B", "[", "k_", "]"}], ":>", "k"}], ",", 
             RowBox[{
              RowBox[{"BB", "[", "k_", "]"}], ":>", "k"}]}], "}"}]}], "//", 
          "DeleteDuplicates"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{
          RowBox[{
          "If", " ", "the", " ", "number", " ", "of", " ", "options", " ", 
           "is", " ", "too", " ", "large"}], ",", " ", 
          RowBox[{
          "go", " ", "to", " ", "the", " ", "next", " ", "equation"}]}], " ", 
         "*)"}], 
        RowBox[{"numOpt", "=", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"2", "^", 
            RowBox[{"Length", "[", 
             RowBox[{"Cases", "[", 
              RowBox[{
               RowBox[{"vars", "[", 
                RowBox[{"[", "pos", "]"}], "]"}], ",", "_A"}], "]"}], "]"}]}],
            ")"}], "*", 
          RowBox[{"(", 
           RowBox[{"Times", "@@", 
            RowBox[{"(", 
             RowBox[{"Length", "/@", 
              RowBox[{"(", 
               RowBox[{"Bcases", "/@", "Borbits"}], ")"}]}], ")"}]}], 
           ")"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"numOpt", ">", 
           RowBox[{"2", "^", "MaxVar"}]}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"AppendTo", "[", 
            RowBox[{"bckpeqs", ",", 
             RowBox[{"eqsA", "[", 
              RowBox[{"[", "pos", "]"}], "]"}]}], "]"}], ";", 
           RowBox[{"eqsA", "=", 
            RowBox[{"Delete", "[", 
             RowBox[{"eqsA", ",", "pos"}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"Continue", "[", "]"}], ";"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{
         "We", " ", "now", " ", "scan", " ", "through", " ", "all", " ", 
          "the", " ", "options"}], " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"CombOptions", "=", 
         RowBox[{"Flatten", "/@", 
          RowBox[{"Tuples", "[", 
           RowBox[{"Join", "[", 
            RowBox[{
             RowBox[{"{", "Aoptions", "}"}], ",", 
             RowBox[{"Bcases", "/@", "Borbits"}]}], "]"}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"message", "=", "\"\<going over options...\>\""}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"checks", "=", 
         RowBox[{"RootReduce", "/@", 
          RowBox[{"(", 
           RowBox[{"nowEq", "/.", "CombOptions"}], ")"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{"Look", " ", "for", " ", "integers"}], " ", "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"integers", "=", 
         RowBox[{
          RowBox[{"Position", "[", 
           RowBox[{
            RowBox[{"IntegerQ", "/@", "checks"}], ",", "True"}], "]"}], "//", 
          "Flatten"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{"See", " ", "what", " ", "A", " ", "and", " ", 
          RowBox[{"B", "'"}], "s", " ", "have", " ", "been", " ", "fixed"}], 
         " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"result", "=", 
         RowBox[{"Apply", "[", 
          RowBox[{"Intersection", ",", 
           RowBox[{
            RowBox[{
             RowBox[{"CombOptions", "[", 
              RowBox[{"[", "#", "]"}], "]"}], "&"}], "/@", "integers"}]}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"result", "!=", 
           RowBox[{"{", "}"}]}], ",", "\[IndentingNewLine]", 
          RowBox[{"(*", " ", 
           RowBox[{
            RowBox[{"If", " ", "some", " ", "A", " ", "and", " ", 
             RowBox[{"B", " ", "'"}], "s", " ", "were", " ", "fixed", " ", 
             "we", " ", "save", " ", "the", " ", "result"}], "..."}], " ", 
           "*)"}], "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"found", "=", 
            RowBox[{"result", "/.", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"A", "->", "\"\<A\>\""}], ",", 
               RowBox[{"B", "->", "\"\<B\>\""}], ",", 
               RowBox[{"BB", "->", "\"\<BB\>\""}]}], "}"}]}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"(*", " ", 
            RowBox[{"...", "and", " ", "replace", " ", "the", " ", "result"}],
             " ", "*)"}], "\[IndentingNewLine]", 
           RowBox[{"result", "/.", 
            RowBox[{"Rule", "->", "Set"}]}], ";"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", " ", 
           RowBox[{
           "Otherwise", " ", "we", " ", "keep", " ", "it", " ", "for", " ", 
            "later"}], " ", "*)"}], "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"AppendTo", "[", 
            RowBox[{"bckpeqs", ",", 
             RowBox[{"eqsA", "[", 
              RowBox[{"[", "pos", "]"}], "]"}]}], "]"}], ";", 
           RowBox[{"eqsA", "=", 
            RowBox[{"Delete", "[", 
             RowBox[{"eqsA", ",", "pos"}], "]"}]}], ";"}]}], "]"}]}]}], 
      "\[IndentingNewLine]", "]"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[82]:=",ExpressionUUID->"cabb4904-2052-4754-8097-2eb2ce537c48"],

Cell["\<\
A  routine  to  revisit  equations  which  were  set  aside  as  they  had  \
with  too  many  variables, some  of  which  have  since  been  determined :\
\>", "Text",ExpressionUUID->"6b3585c0-340f-4511-a885-4a431211e063"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ShuffleEqs", "[", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"eqsAtmp", "=", "eqsA"}], "}"}], ",", 
    RowBox[{
     RowBox[{"message", "=", "\"\<shuffling equations...\>\""}], ";", 
     RowBox[{"eqsA", "=", 
      RowBox[{"Join", "[", 
       RowBox[{"bckpeqs", ",", 
        RowBox[{"Select", "[", 
         RowBox[{"eqsAtmp", ",", 
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", 
             RowBox[{"Variables", "[", "#", "]"}], "]"}], ">", "0"}], "&"}]}],
          "]"}]}], "]"}]}], ";", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"eqsA", "[", 
         RowBox[{"[", "i", "]"}], "]"}], "=", 
        RowBox[{"Collect", "[", 
         RowBox[{
          RowBox[{"eqsA", "[", 
           RowBox[{"[", "i", "]"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"A", "[", "_", "]"}], ",", 
            RowBox[{"B", "[", "_", "]"}], ",", 
            RowBox[{"BB", "[", "_", "]"}]}], "}"}], ",", "RootReduce"}], 
         "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", 
         RowBox[{"Length", "[", "eqsA", "]"}]}], "}"}]}], "]"}], ";", 
     RowBox[{"constants", "=", 
      RowBox[{"Join", "[", 
       RowBox[{"constants", ",", 
        RowBox[{"Select", "[", 
         RowBox[{"eqsAtmp", ",", 
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", 
             RowBox[{"Variables", "[", "#", "]"}], "]"}], "==", "0"}], 
           "&"}]}], "]"}]}], "]"}]}], ";", 
     RowBox[{"bckpeqs", "=", 
      RowBox[{"{", "}"}]}]}]}], "]"}]}]], "Input",
 CellLabel->"In[56]:=",ExpressionUUID->"b7345d1c-f800-47c0-8397-44d8566c11c4"],

Cell["\<\
The  main  routine . Given a theory to study, it picks a g, generates \
equations, examines them,  ad infinitum.\
\>", "Text",ExpressionUUID->"bc225848-2bea-4208-bc77-1550b6f873a8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Study", "[", "func_", "]"}], ":=", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"dealtWith", "=", 
     RowBox[{"{", "}"}]}], ";", 
    RowBox[{"Monitor", "[", 
     RowBox[{
      RowBox[{"While", "[", 
       RowBox[{
        RowBox[{"toTry", "!=", 
         RowBox[{"{", "}"}]}], ",", 
        RowBox[{
         RowBox[{"g", "=", 
          RowBox[{"toTry", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], ";", 
         RowBox[{"nowEq", "=", "0"}], ";", 
         RowBox[{"genEqsAB", "[", 
          RowBox[{"g", ",", "func"}], "]"}], ";", 
         RowBox[{"TryFixAB", "[", "]"}], ";", 
         RowBox[{"ShuffleEqs", "[", "]"}], ";", 
         RowBox[{"dealtWith", "=", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"dealtWith", ",", "g"}], "]"}]}]}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{
       "\"\<g:\>\"", ",", "g", ",", "message", ",", "\"\<Length[eqsA]\>\"", 
        ",", 
        RowBox[{"Length", "[", "eqsA", "]"}], ",", "\"\<Length[bckpeqs]\>\"", 
        ",", 
        RowBox[{"Length", "[", "bckpeqs", "]"}], ",", "\"\<#options:\>\"", 
        ",", "numOpt", ",", "\"\<cur.eq:\>\"", ",", "nowEqToDisplay", ",", 
        "\"\<last found:\>\"", ",", "found", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Length", "[", "yetToBeDetermined", "]"}], ",", 
          "yetToBeDetermined"}], "}"}]}], "}"}]}], "]"}]}], ")"}]}]], "Input",\
ExpressionUUID->"4230dee9-a47d-4648-bc21-772ebeeff1b6"],

