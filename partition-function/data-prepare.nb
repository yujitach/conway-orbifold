Cell[BoxData[{
 RowBox[{
  RowBox[{"nmax", "=", "6"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Theta]by\[Eta]", "[", 
    RowBox[{"1", ",", "y_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"-", "I"}], " ", 
    SuperscriptBox["q", 
     RowBox[{"1", "/", "12"}]], 
    SuperscriptBox["y", 
     RowBox[{"1", "/", "2"}]], 
    RowBox[{"Product", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{"y", " ", 
          SuperscriptBox["q", 
           RowBox[{"n", "+", "1"}]]}]}], ")"}], 
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{
          SuperscriptBox["y", 
           RowBox[{"-", "1"}]], " ", 
          SuperscriptBox["q", "n"]}]}], ")"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"n", ",", "0", ",", "nmax"}], "}"}]}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
