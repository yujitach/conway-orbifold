         " ", 
         RowBox[{"SeparateEvenPart", "[", 
          RowBox[{"p", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"PhaseDiff", " ", "=", " ", 
         RowBox[{"PhaseDiff", "-", " ", 
          RowBox[{"gint", " ", 
           RowBox[{"p", "[", 
