    RowBox[{"Product", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "+", 
         RowBox[{"y", " ", 
          SuperscriptBox["q", 
           RowBox[{"n", "+", "1"}]]}]}], ")"}], 
