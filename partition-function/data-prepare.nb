Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ZF24", "[", 
    RowBox[{"i_", ",", "angles_"}], "]"}], ":=", "\[IndentingNewLine]", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"angles", "===", "0"}], ",", "\[IndentingNewLine]", " ", "0", 
     ",", "\[IndentingNewLine]", 
     RowBox[{"Product", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          SuperscriptBox["q", 
           FractionBox[
            SuperscriptBox[
             RowBox[{"z", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "2"], "2"]], " ", 
          RowBox[{"\[Theta]by\[Eta]", "[", 
           RowBox[{"i", ",", "y"}], "]"}]}], "/.", " ", 
         RowBox[{
          RowBox[{"y", "^", "pow_"}], ":>", 
          RowBox[{
           RowBox[{"Exp", "[", 
            RowBox[{"2", " ", "\[Pi]", " ", "I", " ", 
             RowBox[{"z", "[", 
              RowBox[{"[", "2", "]"}], "]"}], "*", "pow"}], "]"}], " ", 
           RowBox[{"q", "^", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"z", "[", 
               RowBox[{"[", "1", "]"}], "]"}], "*", "pow"}], ")"}]}]}]}]}], 
        " ", "/.", " ", 
        RowBox[{"y", ":>", 
         RowBox[{
          RowBox[{"Exp", "[", 
           RowBox[{"2", " ", "\[Pi]", " ", "I", " ", 
            RowBox[{"z", "[", 
             RowBox[{"[", "2", "]"}], "]"}]}], "]"}], " ", 
          RowBox[{"q", "^", 
           RowBox[{"(", 
            RowBox[{"z", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ")"}]}]}]}]}], ",", 
       RowBox[{"{", 
        RowBox[{"z", ",", "angles"}], "}"}]}], "]"}]}], "\[IndentingNewLine]",
     "]"}]}], ";"}]], "Input",
 CellLabel->"In[9]:=",ExpressionUUID->"822a57b9-d707-4c78-877a-4a8d4af46fb1"],

