Cell["Function to clean coefficients", "Subsection",
 CellChangeTimes->{{3.981812439141063*^9, 
  3.9818124440935383`*^9}},ExpressionUUID->"f2cd0a66-8b81-4ee9-a363-\
0211cccab765"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"CleanSmallNumeric", "[", 
    RowBox[{
     RowBox[{"z_", "?", "NumericQ"}], ",", 
     RowBox[{"tol_", ":", 
      RowBox[{"10", "^", 
       RowBox[{"-", "14"}]}]}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"re", "=", 
        RowBox[{"Re", "[", "z", "]"}]}], ",", 
       RowBox[{"im", "=", 
        RowBox[{"Im", "[", "z", "]"}]}]}], "}"}], ",", "\[IndentingNewLine]", 
     
     RowBox[{
      RowBox[{"re", " ", "=", " ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Abs", "[", "re", "]"}], "<", "tol"}], ",", "0", ",", 
         "re"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"im", " ", "=", " ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Abs", "[", "im", "]"}], "<", "tol"}], ",", "0", ",", 
         "im"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"re", " ", "+", " ", 
       RowBox[{"im", " ", "\[ImaginaryI]"}]}]}]}], "\[IndentingNewLine]", 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"MapCoefficients", "[", 
    RowBox[{"expr_", ",", "func_", ",", "x_Symbol"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "terms", "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"terms", "=", 
       RowBox[{"Expand", "[", "expr", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{
        "If", " ", "expr", " ", "was", " ", "just", " ", "a", " ", 
         "constant"}], ",", " ", 
        RowBox[{
         RowBox[{"List", " ", "@@", " ", 
          RowBox[{"Expand", "[", "expr", "]"}]}], " ", "is", " ", "not", " ", 
         "a", " ", "list"}], ",", " ", 
        RowBox[{
        "so", " ", "we", " ", "have", " ", "to", " ", "make", " ", "it", " ", 
         "a", " ", "list", " ", "by", " ", "hand"}]}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"terms", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Head", "[", "terms", "]"}], "===", "Plus"}], ",", 
         RowBox[{"List", "@@", "terms"}], ",", 
         RowBox[{"{", "terms", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Do", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"FreeQ", "[", 
           RowBox[{
            RowBox[{"terms", "[", 
             RowBox[{"[", "i", "]"}], "]"}], ",", "x"}], "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"terms", "[", 
            RowBox[{"[", "i", "]"}], "]"}], " ", "=", " ", 
           RowBox[{"func", "[", 
            RowBox[{"terms", "[", 
             RowBox[{"[", "i", "]"}], "]"}], "]"}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"terms", "[", 
            RowBox[{"[", "i", "]"}], "]"}], " ", "=", " ", 
           RowBox[{
            RowBox[{"terms", "[", 
             RowBox[{"[", "i", "]"}], "]"}], "/.", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"a_.", "*", 
               RowBox[{"x", "^", "n_."}]}], ":>", 
              RowBox[{
               RowBox[{"func", "[", "a", "]"}], "*", 
               RowBox[{"x", "^", "n"}]}]}], ")"}]}]}]}], 
         "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", 
          RowBox[{"Length", "[", "terms", "]"}]}], "}"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Total", "[", "terms", "]"}]}]}], "\[IndentingNewLine]", 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"CleanSmallCoefficients", "[", "expr_", "]"}], " ", ":=", 
   RowBox[{"MapCoefficients", "[", 
    RowBox[{"expr", ",", "CleanSmallNumeric", ",", "q"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"CleanSmallCoefficientsAfterN", "[", "expr_", "]"}], " ", ":=", 
   " ", 
   RowBox[{"MapCoefficients", "[", 
    RowBox[{
     RowBox[{"N", "[", "expr", "]"}], ",", "CleanSmallNumeric", ",", "q"}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Usage", ":", "\[IndentingNewLine]", 
     RowBox[{"CleanSmallCoefficients", "[", 
      RowBox[{"Normal", "[", 
       RowBox[{
        RowBox[{"ZVRR", "[", "angles", "]"}], "+", 
        RowBox[{
         RowBox[{"O", "[", "q", "]"}], "^", 
         RowBox[{"(", 
          RowBox[{"3", "/", "den"}], ")"}]}]}], "]"}], "]"}]}], ";", 
    "\[IndentingNewLine]", " ", 
    RowBox[{"Simplify", "[", 
     RowBox[{"CleanSmallCoefficients", "[", 
      RowBox[{"Normal", "[", 
       RowBox[{
        RowBox[{"ZVRR", "[", "angles", "]"}], "+", 
        RowBox[{
         RowBox[{"O", "[", "q", "]"}], "^", 
         RowBox[{"(", 
          RowBox[{"3", "/", "den"}], ")"}]}]}], "]"}], "]"}], "]"}], ";"}], 
   "\[IndentingNewLine]", "*)"}]}]}], "Input",
 CellChangeTimes->{{3.963452034145903*^9, 3.9634520366075926`*^9}, {
   3.963452067360199*^9, 3.9634520956510077`*^9}, {3.963452192888111*^9, 
