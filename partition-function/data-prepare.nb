      ";", "\[IndentingNewLine]", 
      RowBox[{"Summand", " ", "=", " ", 
       RowBox[{
        RowBox[{"HeckePhase", "[", 
         RowBox[{"b", ",", "d", ",", "angles"}], "]"}], " ", 
        RowBox[{"Exp", "[", 
         RowBox[{"2", "\[Pi]", " ", "\[ImaginaryI]", " ", "PhaseDiff"}], 
         "]"}], " ", 
        RowBox[{"Simplify", "[", " ", 
         RowBox[{"CleanSmallCoefficients", "[", " ", 
          RowBox[{"Normal", "[", " ", 
           RowBox[{
            RowBox[{"ZVRR", "[", "RedHeckeAngs", "]"}], "+", 
            RowBox[{
             RowBox[{"O", "[", "q", "]"}], "^", 
             RowBox[{"(", 
              RowBox[{"3", "/", "den"}], ")"}]}]}], " ", "]"}], " ", "]"}], 
         " ", "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Summand", " ", "=", " ", 
       RowBox[{"ToRadicals", "[", 
        RowBox[{"FullSimplify", "[", "Summand", "]"}], "]"}]}]}]}], 
    "]"}]}]}]], "Input",
 CellLabel->"In[29]:=",ExpressionUUID->"b82925ae-43fe-4878-a09e-bc5d406f9e25"],

