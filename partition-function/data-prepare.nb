Cell[BoxData[
 RowBox[{
  RowBox[{"heckeSummand", "[", 
   RowBox[{"{", 
    RowBox[{"ComPair_", ",", "a_", ",", "b_", ",", "d_"}], "}"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"heckeSummand", "[", 
    RowBox[{"{", 
     RowBox[{"ComPair", ",", "a", ",", "b", ",", "d"}], "}"}], "]"}], "=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "den", ",", " ", "RedHeckeAngs", ",", " ", "PhaseDiff", ",", " ", 
       "Summand", ",", 
       RowBox[{"angles", "=", 
        RowBox[{"angleForPair", "[", "ComPair", "]"}]}]}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"den", "=", 
       RowBox[{"Max", "@@", 
        RowBox[{"Denominator", "[", "angles", "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"RedHeckeAngs", ",", " ", "PhaseDiff"}], "}"}], " ", "=", " ", 
       RowBox[{"ReduceAng", "[", 
        RowBox[{"HeckeTwistAngle", "[", 
