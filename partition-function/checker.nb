Cell[BoxData[
 RowBox[{
  RowBox[{"check", "[", 
   RowBox[{"PF_", ",", "i_"}], "]"}], ":=", 
  RowBox[{"And", "@@", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"unknown", "[", 
        RowBox[{"orbIndex", "[", 
         RowBox[{"{", 
          RowBox[{"i", ",", "j"}], "}"}], "]"}], "]"}], "  ", 
       RowBox[{"defaultPhase", "[", 
        RowBox[{"orbitRepresentative", "[", 
         RowBox[{"{", 
          RowBox[{"i", ",", "j"}], "}"}], "]"}], "]"}], " ", 
       RowBox[{"PF", "[", 
        RowBox[{"{", 
         RowBox[{"i", ",", "j"}], "}"}], "]"}]}], "==", 
      RowBox[{
       RowBox[{"unknown", "[", 
        RowBox[{"orbIndex", "[", 
         RowBox[{"{", 
          RowBox[{"i", ",", 
           RowBox[{"zaction", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "j"}], "]"}], "]"}]}], "}"}], "]"}], "]"}], "  ", 
       RowBox[{"defaultPhase", "[", 
        RowBox[{"orbitRepresentative", "[", 
         RowBox[{"{", 
          RowBox[{"i", ",", 
           RowBox[{"zaction", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "j"}], "]"}], "]"}]}], "}"}], "]"}], "]"}], 
       " ", 
       RowBox[{"PF", "[", 
        RowBox[{"{", 
         RowBox[{"i", ",", 
          RowBox[{"zaction", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "j"}], "]"}], "]"}]}], "}"}], "]"}]}]}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "1", ",", 
       RowBox[{"Length", "[", 
        RowBox[{"sizes", "[", 
         RowBox[{"[", "i", "]"}], "]"}], "]"}]}], "}"}]}], "]"}]}]}]], "Input",\

 CellChangeTimes->{{3.987203079530618*^9, 3.987203193490799*^9}},
 CellLabel->"In[49]:=",ExpressionUUID->"37e2ef2c-e8a5-4e43-936c-f183b9feabed"],

