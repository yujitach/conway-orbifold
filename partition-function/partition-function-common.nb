Cell["There  are  699  orbits .", "Text",ExpressionUUID->"59ae50f5-ff0a-412b-abff-9f3087fd3418"],

Cell["\<\
Orbits  #1  to  #160  are  {1, _} .\[LineSeparator]Orbits #161 to #218 are \
{2,_}.   (1 is the identity and 2 is the center z.)\[LineSeparator]Orbits \
#219 to #227 are {3,_}.   \[LineSeparator]Orbits #228 to #234 are {4,_}.  (3 \
is 6d, 4 is 3d. which are related by z.)\[LineSeparator]#235 is the first \
complex orbit.\
\>", "Text",ExpressionUUID->"8c70a69e-ea74-4cc2-a0f7-7a17a753d97b"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Characters", "Subsection",ExpressionUUID->"0b0f27bd-2b08-44fc-8561-effa3071130f"],

Cell["\<\
char[i]  is  the  character  table  of  the  centralizer  of  the  \
representative  of  the  i - th  conjugacy  class  of  Co0 .\
\>", "Text",ExpressionUUID->"ec518118-dcd6-406f-b203-3a5cb44e09f2"],

