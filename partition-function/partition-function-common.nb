Cell["SL(2,Z) and other actions", "Subsection",ExpressionUUID->"85c374dc-bb40-4c03-b13a-e0a3398b2c87"],

Cell["\<\
taction, sqaction, paction, zaction records h \[Rule] hg, h\[Rule]h^2, h \
\[Rule] h^{-1}, h\[Rule]hz \
\>", "Text",ExpressionUUID->"c89864e2-0875-43d7-90e9-c58acda3f57b"],

