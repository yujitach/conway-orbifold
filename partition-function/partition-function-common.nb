Cell[CellGroupData[{

Cell["SL(2,Z) and other actions", "Subsection",ExpressionUUID->"85c374dc-bb40-4c03-b13a-e0a3398b2c87"],

Cell["\<\
taction, sqaction, paction, zaction record h \[Rule] hg, h\[Rule]h^2, h \
\[Rule] h^{-1}, h\[Rule]hz , respectively, where z is the generator of the \
center.\
\>", "Text",ExpressionUUID->"c89864e2-0875-43d7-90e9-c58acda3f57b"],

Cell["saction records (g,h) ->(h, g^{-1}).", "Text",ExpressionUUID->"81449e3d-2447-44d9-8ee4-3e16162bc327"],

Cell[BoxData[
 RowBox[{
  RowBox[{"<<", "\"\<../data/co0actions.m\>\""}], ";"}]], "Input",
 CellLabel->"In[5]:=",ExpressionUUID->"a6dab18e-03e8-4e90-814d-21989048f63d"],

Cell["\<\
SL2ZOrbits[[i]]  contains  {j, k}  for  the  i-th SL(2,Z) orbit \
\>", "Text",ExpressionUUID->"333b4a78-96cb-4039-bb56-16fa6cc6c7a3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"<<", "\"\<../data/co0orbits.m\>\""}], ";"}]], "Input",
 CellLabel->"In[6]:=",ExpressionUUID->"b9c7bf67-a98b-477a-9722-e173c1d2a8cb"],

Cell["\<\
pacOnOrbit  computes the action of [g,h] \[Rule] [g,h^{-1}] at the level of \
SL2Z orbits. A real orbit is mapped by pacOnOrbit to itself; complex orbits \
form pairs. cpxOrbits is the list of complex orbits\
\>", "Text",ExpressionUUID->"0c781bf5-9e20-44b6-9190-093c7fd7f181"],

Cell[BoxData[
 RowBox[{
  RowBox[{"<<", "\"\<../data/co0orbitData.m\>\""}], ";"}]], "Input",
 CellLabel->"In[7]:=",ExpressionUUID->"cbe28a60-ceee-4f45-aa27-800a86407816"],

