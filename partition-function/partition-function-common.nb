  FormBox[
   SubscriptBox["h", "j"], TraditionalForm]],ExpressionUUID->
  "c7f46955-acdf-49ed-b9ef-b5dfb66d3c16"],
 " within the centralizer of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["g", "i"], TraditionalForm]],ExpressionUUID->
  "34bf9846-5c84-45fe-983c-6e5a19cae5ff"],
 " . "
}], "Text",ExpressionUUID->"d15bc35d-9201-42ca-b195-ab96a19c289c"],

