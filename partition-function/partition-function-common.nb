Cell[TextData[{
 "many  data  are  of  the  form  something[[i, j]] , containing some info on \
the commuting pair ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    SubscriptBox["g", "i"]}], TraditionalForm]],ExpressionUUID->
  "29ad4739-3a78-4530-957b-1e13f63c4a47"],
