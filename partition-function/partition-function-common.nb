   SubscriptBox["h", "j"], TraditionalForm]],ExpressionUUID->
  "730dd2b3-0c7d-4963-902a-229dface1a03"],
 "), where ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["g", "i"], TraditionalForm]],ExpressionUUID->
  "ffaef53a-e1ac-4898-ba3d-be2044d873ff"],
 "runs over (representatives of) conjugacy classes of Co0, and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["h", "i"], TraditionalForm]],ExpressionUUID->
  "5adcdba2-ed24-4ea7-a0b3-1e51a9da5805"],
 " runs over (representatives of) conjugacy classes of the centralizer of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["g", "i"], " "}], TraditionalForm]],ExpressionUUID->
  "0b4c17b0-8a0b-47a2-bef7-c2442df4210a"],
 "within Co0."
}], "Text",ExpressionUUID->"2e0f8c67-ffc6-493b-a6ef-1e51cb26fcee"],

