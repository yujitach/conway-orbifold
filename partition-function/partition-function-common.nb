Cell[BoxData[
 RowBox[{
  RowBox[{"realOrbits", "=", 
   RowBox[{"Complement", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{"i", ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", 
         RowBox[{"Length", "[", "SL2ZOrbits", "]"}]}], "}"}]}], "]"}], ",", 
     "cpxOrbits"}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[9]:=",ExpressionUUID->"17b4cf75-746c-4a2b-abd8-95929f7bc588"],

Cell["There  are  699  orbits .", "Text",ExpressionUUID->"59ae50f5-ff0a-412b-abff-9f3087fd3418"],

Cell["\<\
By inspection, we find that:\[LineSeparator]Orbits  #1  to  #160  are  {1, _} \
.\[LineSeparator]Orbits #161 to #218 are {2,_}.   (1 is the identity and 2 is \
the center z.)\[LineSeparator]Orbits #219 to #227 are {3,_}.   \
\[LineSeparator]Orbits #228 to #234 are {4,_}.  (3 is 6d, 4 is 3d. which are \
related by z.)\[LineSeparator]#235 is the first complex orbit.\
\>", "Text",ExpressionUUID->"8c70a69e-ea74-4cc2-a0f7-7a17a753d97b"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Characters", "Subsection",ExpressionUUID->"0b0f27bd-2b08-44fc-8561-effa3071130f"],

Cell["\<\
char[i]  is  the  character  table  of  the  centralizer  of  the  \
representative  of  the  i - th  conjugacy  class  of  Co0 .\
\>", "Text",ExpressionUUID->"ec518118-dcd6-406f-b203-3a5cb44e09f2"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"EE", "[", "n_", "]"}], ":=", 
   RowBox[{"Exp", "[", 
    RowBox[{"2", "Pi", " ", 
     RowBox[{"I", "/", "n"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[10]:=",ExpressionUUID->"fe5d7bda-4375-4c75-bfb7-f58bb279782b"],

Cell[BoxData[
 RowBox[{"Do", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"char", "[", "i", "]"}], "=", 
     RowBox[{"<<", 
      RowBox[{"(", 
       RowBox[{"\"\<../data/irr0/irr-\>\"", "<>", 
        RowBox[{"ToString", "[", "i", "]"}], "<>", "\"\<.m\>\""}], ")"}]}]}], 
    ";"}], ",", 
   RowBox[{"{", 
    RowBox[{"i", ",", "1", ",", "167"}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[11]:=",ExpressionUUID->"0492edd9-8394-4f8c-8237-4d005413fef0"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Abelian groups generated by commuting pairs", "Subsection",ExpressionUUID->"5f9024b1-99e5-433d-b716-f324d1919f8f"],

Cell[TextData[{
 "abelianOrders[[i,j]] is a list {a,b,c} where a, b, c are the order of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["g", "i"], TraditionalForm]],ExpressionUUID->
  "53796e63-90e9-4cc4-b07b-73342236d39e"],
 " , the order of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["h", "j"], TraditionalForm]],ExpressionUUID->
  "7254ba7d-2a49-43a2-b67b-e8cf79bcde6e"],
 ", and the order of the Abelian group generated by ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["g", "i"], TraditionalForm]],ExpressionUUID->
  "8b9c2776-19ef-43c4-8a88-104fd4848e01"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["h", "j"], TraditionalForm]],ExpressionUUID->
  "8baedd02-e9cd-4fa7-871d-b404a11d7849"],
 " ."
}], "Text",ExpressionUUID->"58e5d6f9-e759-439b-b31e-7ca8e304cb3a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"<<", "\"\<../data/co0abelianOrders.m\>\""}], ";"}]], "Input",
 CellLabel->"In[12]:=",ExpressionUUID->"198eae08-7da1-491d-8875-ffa38d3429dc"],

Cell[TextData[{
 "For  each SL(2,Z) orbit #i, betterOrbitRep[[i]] is a particular (g,h) such \
that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"<", "g", ">"}], " ", "=", " ", 
    SubscriptBox["Z", "a"]}], TraditionalForm]],ExpressionUUID->
  "b2086f5a-cc75-483d-bf9d-fda22be9ba55"],
 " , <h> = ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["Z", "b"], TraditionalForm]],ExpressionUUID->
  "76998d8b-edae-41d1-a120-2b0e1585ab6b"],
 " , <g,h> = ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["Z", 
      RowBox[{"a", " "}]], "\[Cross]", " ", 
     SubscriptBox["Z", "b"]}], " ", ","}], TraditionalForm]],ExpressionUUID->
  "37b99895-00bf-4617-9fdc-377d455c5306"],
 " and a|b. "
}], "Text",ExpressionUUID->"6b5faadb-4ea1-472f-b57f-010118e92ee3"],

Cell["\<\
They  are  also  arranged so that for complex pairs of SL2Z orbits are \
represented by (g,h) and (g,h^{-1}).\
\>", "Text",ExpressionUUID->"11e07014-8318-4edc-8147-d62c97f3cae8"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Partition functions", "Section",ExpressionUUID->"2f5a07c2-fa23-436a-b887-ccf960e2f1ae"],

Cell[CellGroupData[{

Cell[TextData[{
 "Read precomputed data  of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["S", "24"], TraditionalForm]],ExpressionUUID->
  "037e6c83-cfbd-4296-b5f9-7e70d94f10ca"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["A", "24"], TraditionalForm]],ExpressionUUID->
  "e39f829d-849e-4e8c-b614-c72624a91650"],
 "orbifold of Duncan theory"
}], "Subsubsection",ExpressionUUID->"4de7341f-f0fb-43f4-9973-685db5b8df43"],

Cell[BoxData[
 RowBox[{
  RowBox[{"<<", "\"\<../data/PartitionFunctionData.m\>\""}], ";"}]], "Input",
 CellLabel->"In[13]:=",ExpressionUUID->"c8d9911a-0482-4d18-abe5-0bc2cde9632a"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Define the partition functions of 24 copies of Duncan, and their sym and alt \
orbifolds, as Co0 symmetric theories\
\>", "Subsubsection",ExpressionUUID->"5c264fd2-55ea-4ebc-85ed-5f9ab93c237d"],

Cell[TextData[{
 "orbIndex  is  a  map from a commuting pair ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    SubscriptBox["g", "i"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "467a9ae9-4721-4172-a8cb-51d1fb390ce3"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["h", "j"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0b72584e-89eb-4d91-8d06-bdb03c009b4f"],
 ") to the id of the SL2Z orbit containing it."
}], "Text",ExpressionUUID->"16ab63e8-6f39-4611-9282-4ae899cf2fd1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"orbIndex", "=", 
   RowBox[{"<|", "|>"}]}], ";"}]], "Input",
 CellLabel->"In[14]:=",ExpressionUUID->"69dd81f9-cf6e-4a0a-ba30-ba71c26c17b2"],

Cell[BoxData[
 RowBox[{"Do", "[", 
  RowBox[{
   RowBox[{"Do", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"orbIndex", "[", "x", "]"}], "=", "i"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", 
       RowBox[{"SL2ZOrbits", "[", 
        RowBox[{"[", "i", "]"}], "]"}]}], "}"}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"i", ",", "1", ",", 
     RowBox[{"Length", "[", "SL2ZOrbits", "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[15]:=",ExpressionUUID->"0adfa4bd-bc65-4454-aa69-899ac1ccd06b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"orbitRepresentative", "[", "orb_", "]"}], ":=", 
  RowBox[{"betterOrbitRep", "[", 
   RowBox[{"[", 
    RowBox[{"orbIndex", "[", "orb", "]"}], "]"}], "]"}]}]], "Input",
 CellLabel->"In[16]:=",ExpressionUUID->"71568d86-a6fc-48f0-97f8-e01c7673f9ab"],

Cell["\<\
SinglePF  is the partition function of the Duncan theory with twists.\
\>", "Text",ExpressionUUID->"68a2c648-3ea7-4f2c-a98c-4468f75bf3d5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SinglePF", "[", "x_", "]"}], ":=", 
  RowBox[{
   RowBox[{"GenHecke", "[", 
    RowBox[{"{", 
     RowBox[{"x", ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0"}], "}"}]}], "}"}], "]"}], "[", 
   RowBox[{"[", "1", "]"}], "]"}]}]], "Input",
 CellLabel->"In[17]:=",ExpressionUUID->"6008e14a-5a4b-415d-b219-3b442c85424e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"SinglePF", "[", 
  RowBox[{"orbitRepresentative", "[", 
   RowBox[{"{", 
    RowBox[{"1", ",", "1"}], "}"}], "]"}], "]"}]], "Input",
 CellLabel->"In[18]:=",ExpressionUUID->"434afbe0-983e-4941-b4ec-3c7c6adc8d02"],

Cell[BoxData[
 RowBox[{"-", "24"}]], "Output",
 CellLabel->"Out[18]=",ExpressionUUID->"f77d0ad2-b716-4673-b802-1d7872fcdc96"]
}, Open  ]],

Cell["Then this  is Duncan^24:", "Text",ExpressionUUID->"f424246c-8304-485a-b143-fdc9f5754085"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"PF24", "[", "x_", "]"}], ":=", 
   RowBox[{
    RowBox[{"SinglePF", "[", 
     RowBox[{"orbitRepresentative", "[", "x", "]"}], "]"}], "^", "24"}]}], 
  ";"}]], "Input",
 CellLabel->"In[19]:=",ExpressionUUID->"80589c4a-8082-4b3b-8eaf-6f9f1e85c0c3"],

Cell["\<\
To  define symmetric/alternating orbifolds, we define two abbreviations.\
\>", "Text",ExpressionUUID->"1d8b0548-2389-458d-8a4a-b96243376f4b"],

