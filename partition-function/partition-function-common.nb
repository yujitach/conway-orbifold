 RowBox[{
  RowBox[{"realOrbits", "=", 
   RowBox[{"Complement", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{"i", ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", 
         RowBox[{"Length", "[", "SL2ZOrbits", "]"}]}], "}"}]}], "]"}], ",", 
